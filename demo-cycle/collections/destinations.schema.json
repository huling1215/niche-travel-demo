      "required": [
        "slug",
        "name",
        "region",
        "coords",
        "altitude",
        "cover",
        "coverAlt",
        "positioning",
        "arrival",
        "glance",
        "seasons",
        "mapPos"
      ],
      "additionalProperties": false
