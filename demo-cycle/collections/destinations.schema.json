{
  "$ref": "#/definitions/destinations",
  "definitions": {
    "destinations": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "coords": {
          "type": "string"
        },
        "altitude": {
          "type": "string"
        },
        "cover": {
          "type": "string"
        },
        "coverAlt": {
          "type": "string"
        },
        "positioning": {
          "type": "string"
        },
        "arrival": {
          "type": "string"
        },
        "subAreas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "vibe": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "vibe"
            ],
            "additionalProperties": false
          },
          "default": []
