              "label",
              "value",
              "detail"
            ],
            "additionalProperties": false
          },
          "minItems": 4
        },
        "seasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "season": {
                "type": "string"
              },
              "weather": {
                "type": "string"
              },
              "highlights": {
                "type": "string"
              },
              "tip": {
                "type": "string"
              }
            },
            "required": [
              "season",
              "weather",
              "highlights",
              "tip"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
        },
        "pitfalls": {
          "type": "array",
          "items": {
